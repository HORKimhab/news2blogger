# Generator: use local Codex CLI authentication by default (no API key).
GENERATOR_PROVIDER=codex
CODEX_COMMAND=codex
# Empty uses the Codex CLI default model available to your ChatGPT plan.
CODEX_MODEL=
CODEX_TIMEOUT_SECONDS=300

# Only required when GENERATOR_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Output
TARGET_LANGUAGE=Khmer
SUMMARY_MAX_WORDS=10000

# Blogger uses Google Desktop-app OAuth, not a plain API key.
# Download the OAuth client as credentials.json, then run `news2blogger list-blogs`.
# Leave blank to automatically use the authorized account's only blog.
# If the account has multiple blogs, use the numeric ID printed in the first column.
BLOGGER_BLOG_ID=
BLOGGER_CLIENT_SECRETS=credentials.json
# Created automatically after successful browser authorization. Do not commit it.
BLOGGER_TOKEN_FILE=token.json

# Safety: drafts are the default. Set true only when you want immediate publishing.
BLOGGER_PUBLISH=false

# Local state
DATABASE_PATH=data/news2blogger.db
LOG_LEVEL=INFO
HTTP_USER_AGENT=news2blogger/0.1 (+https://www.blogger.com/)
